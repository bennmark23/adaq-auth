# ADAQ server environment
PORT=4000
JWT_SECRET=change-me-in-production

# Data directory MUST be on persistent storage (volume/disk), never inside the code folder.
ADAQ_DATA_DIR=/data
BACKUP_KEEP=14

# Only set for a brand-new empty database, to create the initial admin.
# ADAQ_SEED=1

# Staged restore from an admin backup archive, applied before startup.
# ADAQ_RESTORE_FROM=/data/backups/restore-....tar.gz

# Attachment limits
MAX_FILE_MB=5
MAX_VOICE_SECONDS=120
MAX_FILES_PER_DAY_PER_USER=50

# Optional GitHub backup (free) for hosts with ephemeral disks
# GH_BACKUP_TOKEN=
# GH_BACKUP_REPO=owner/repo
# GH_BACKUP_PATH=adaq.db
# GH_BACKUP_BRANCH=main
